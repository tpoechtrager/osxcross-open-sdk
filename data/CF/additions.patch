+    kCFISO8601DateFormatWithDashSeparatorInDate API_AVAILABLE(macos(10.12)) = (1UL << 8),  // Add separator for date ("-")
+    kCFISO8601DateFormatWithColonSeparatorInTime API_AVAILABLE(macos(10.12)) = (1UL << 9),  // Add separator for time (":")
+    kCFISO8601DateFormatWithColonSeparatorInTimeZone API_AVAILABLE(macos(10.12)) = (1UL << 10),  // Add ":" separator in timezone (eg. +08:00)
+    kCFISO8601DateFormatWithFractionalSeconds API_AVAILABLE(macos(10.13)) = (1UL << 11),  // Add 3 significant digits of fractional seconds (".SSS")
+
+    kCFISO8601DateFormatWithFullDate API_AVAILABLE(macos(10.12)) = kCFISO8601DateFormatWithYear | kCFISO8601DateFormatWithMonth | kCFISO8601DateFormatWithDay | kCFISO8601DateFormatWithDashSeparatorInDate,
